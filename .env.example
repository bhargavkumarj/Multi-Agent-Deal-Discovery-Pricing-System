OPENAI_API_KEY=sk-...

SCANNER_MODEL=gpt-4.1-mini
FRONTIER_MODEL=gpt-4.1-mini
MESSENGER_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Push notifications (optional — without these, alerts are logged only)
PUSHOVER_USER=
PUSHOVER_TOKEN=
NOTIFY=true

# Ensemble weights, renormalised over whichever estimators are available
WEIGHT_FRONTIER=0.6
WEIGHT_SPECIALIST=0.25
WEIGHT_NEURAL=0.15

# Alert when an item is at least this many dollars below its estimate
DISCOUNT_THRESHOLD=50
SIMILAR_PRODUCTS=5
DEALS_PER_FEED=10
SHORTLIST_SIZE=5

# The fine-tuned model deployed on Modal
MODAL_APP=pricer-service
MODAL_CLASS=Pricer
